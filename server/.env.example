# Server environment variables — copy to server/.env and fill in values

PORT=5000
NODE_ENV=development

# MongoDB — use Atlas URI in production
MONGO_URI=mongodb://127.0.0.1:27017/legacy-locker

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGIN=http://localhost:5173

# Webhook — insurance callback secret (shared with insurer)
WEBHOOK_SECRET=change_me_to_webhook_secret

# Cloudinary (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Admin (two options — use ONE):
# Option 1 (local dev): place serviceAccount.json in server/ folder
# Option 2 (production): paste full JSON as single line string below
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Email (Gmail SMTP — use App Password, not account password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
